-- 1. Display total freight charge collected by each driver
-- This query sums the freight charges for every driver
SELECT Driver_Name, SUM(Freight_Charge) AS Total_Freight_Collected
FROM Trips
GROUP BY Driver_Name;

-- 2. Find the average fuel used for each route (Started → Route_To)
-- This query calculates the average fuel consumption for each route
SELECT Started, Route_To, AVG(Fuel_Used) AS Avg_Fuel_Used
FROM Trips
GROUP BY Started, Route_To;

-- 3. Display drivers who have made more than 2 trips
-- This query counts trips per driver and filters those with more than 2 trips
SELECT Driver_Name, COUNT(*) AS Total_Trips
FROM Trips
GROUP BY Driver_Name
HAVING COUNT(*) > 2;

-- 4. Find the maximum distance travelled by each driver
-- This query finds the longest distance travelled in a single trip per driver
SELECT Driver_Name, MAX(Distance_KM) AS Max_Distance
FROM Trips
GROUP BY Driver_Name;

-- 5. Find total fuel used per starting city
-- This query sums fuel usage for trips originating from each starting city
SELECT Started, SUM(Fuel_Used) AS Total_Fuel_Used
FROM Trips
GROUP BY Started;

-- 7. Find the route (Started → Route_To) with the highest total freight charge
-- This query sums freight charges per route and orders to find the highest
SELECT Started, Route_To, SUM(Freight_Charge) AS Total_Freight
FROM Trips
GROUP BY Started, Route_To
ORDER BY Total_Freight DESC
LIMIT 1;

-- 8. Display the top 3 highest Total_Price trips
-- This query lists the three trips with the highest total price
SELECT *
FROM Trips
ORDER BY Total_Price DESC
LIMIT 3;

